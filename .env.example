# ─────────────────────────────────────────────────────────────
# BTranslate — Environment Configuration (example)
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
# App listens on this port only. CloudPanel/Nginx reverse-proxies 80/443 -> PORT.
PORT=3000
# Interface the app binds to. CloudPanel/Nginx proxies to 127.0.0.1, so keep
# the default to make the Node port unreachable from outside. Use 0.0.0.0 only
# if you deliberately need direct access (e.g. LAN testing without Nginx).
HOST=127.0.0.1

# Time zone for every human-facing time (exports, history, logs) and for what
# a "day" means in the history/log pickers. The database always stores UTC.
APP_TIMEZONE=Europe/Istanbul

# ── MySQL ────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=btranslate
# The app's own MySQL user (required; there is no 'root' fallback).
DB_USER=
DB_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────
# REQUIRED in production: a long random string (at least 32 characters) used
# to sign host JWT tokens. The server refuses to start in production without
# one. Generate it with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Optional initial admin password, used only by the first `npm run migrate`
# (min. 8 characters). Leave empty to have migrate generate a strong random
# password and print it once. Remove it from .env after the first login.
# `npm run set-admin-password` also reads it (or prompts when it is empty).
ADMIN_PASSWORD=

# ── Google Workspace sign-in (SAML) for the admin panel ──────
# Optional. When all four values below are set, the login screen shows
# "Google ile giriş yap". Only accounts added in the panel with an email on
# SSO_EMAIL_DOMAIN can sign in this way; everyone else is refused.
# Public https address of this app (also builds the ACS URL / entity ID).
PUBLIC_BASE_URL=
# From Google Admin console → the custom SAML app → "Google Identity Provider details":
SAML_IDP_SSO_URL=
SAML_IDP_ENTITY_ID=
# The downloaded certificate: a file path (recommended) or the PEM inline.
SAML_IDP_CERT_FILE=
# SAML_IDP_CERT=
SSO_EMAIL_DOMAIN=beykoz.edu.tr

# ── DeepL translation (text API) ─────────────────────────────
# The API key is used ONLY on the server and is NEVER sent to the browser.
# Free keys (ending in ":fx") use api-free.deepl.com automatically.
DEEPL_API_KEY=
# Optional: override the DeepL REST base URL (e.g. a proxy). Auto-detected
# from the key (free/pro) when left empty.
DEEPL_API_URL=
# Enable translated audio (spoken aloud on participant devices via the
# browser's text-to-speech). If false, live transcript + text translation
# still work fully.
ENABLE_TRANSLATED_AUDIO=true

# ── OpenAI realtime speech engine (optional, selectable in the panel) ─────
# Used only when the admin sets the voice engine to "OpenAI realtime" in
# Settings. Key stays server-side. Real-time speech-to-speech translation.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-translate
# OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime/translations

# ── Hallucination / post-processing filters ──────────────────
# Reject final segments shorter than this many characters.
FILTER_MIN_CHARS=2
# Reject final segments with fewer than this many words (set 0 to allow single words).
FILTER_MIN_WORDS=1
