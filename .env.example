# ─────────────────────────────────────────────────────────────
# BTranslate — Environment Configuration (example)
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
# App listens on this port only. CloudPanel/Nginx reverse-proxies 80/443 -> PORT.
PORT=3000

# ── MySQL ────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=btranslate
DB_USER=
DB_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────
# Long random string. Used to sign host JWT tokens.
JWT_SECRET=change-me-to-a-long-random-string
# Initial admin password, seeded on first `npm run migrate`.
ADMIN_PASSWORD=admin123

# ── DeepL Voice API ──────────────────────────────────────────
# The API key is used ONLY on the server and is NEVER sent to the browser.
DEEPL_API_KEY=
# WebSocket endpoint of the DeepL real-time voice/speech service.
# Verify the exact URL against your DeepL Voice account/plan.
DEEPL_VOICE_WS_URL=wss://api.deepl.com/v1/voice/realtime
# Enable server-side translated speech-to-speech audio (if your plan supports it).
# If false or unsupported, live transcript + text translation still work fully.
ENABLE_TRANSLATED_AUDIO=true

# ── Voice Activity Detection (browser side, delivered via /api/config) ──
# RMS energy threshold [0..1]. Higher = less sensitive (fewer false triggers).
VAD_THRESHOLD=0.015
# Sustained speech (ms) required before a segment starts.
VAD_MIN_SPEECH_MS=250
# Silence (ms) required before a segment ends.
VAD_SILENCE_MS=800

# ── Hallucination / post-processing filters ──────────────────
# Reject final segments shorter than this many characters.
FILTER_MIN_CHARS=2
# Reject final segments with fewer than this many words (set 0 to allow single words).
FILTER_MIN_WORDS=1
