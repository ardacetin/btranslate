# ─────────────────────────────────────────────────────────────
# BTranslate — Environment Configuration (example)
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
# App listens on this port only. CloudPanel/Nginx reverse-proxies 80/443 -> PORT.
PORT=3000

# ── MySQL ────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=btranslate
DB_USER=
DB_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────
# Long random string. Used to sign host JWT tokens.
JWT_SECRET=change-me-to-a-long-random-string
# Initial admin password, seeded on first `npm run migrate`.
ADMIN_PASSWORD=admin123

# ── DeepL translation (text API) ─────────────────────────────
# The API key is used ONLY on the server and is NEVER sent to the browser.
# Free keys (ending in ":fx") use api-free.deepl.com automatically.
DEEPL_API_KEY=
# Optional: override the DeepL REST base URL (e.g. a proxy). Auto-detected
# from the key (free/pro) when left empty.
DEEPL_API_URL=
# Enable translated audio (spoken aloud on participant devices via the
# browser's text-to-speech). If false, live transcript + text translation
# still work fully.
ENABLE_TRANSLATED_AUDIO=true

# ── Hallucination / post-processing filters ──────────────────
# Reject final segments shorter than this many characters.
FILTER_MIN_CHARS=2
# Reject final segments with fewer than this many words (set 0 to allow single words).
FILTER_MIN_WORDS=1
